<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Attendance Management</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="public-shell d-flex flex-column min-vh-100">
    <header class="border-bottom py-3 bg-white">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-primary rounded-3 fs-6">AMS</span>
                <div>
                    <div class="fw-bold">Attendance Management System</div>
                    <small class="text-muted">Smart workforce orchestration</small>
                </div>
            </div>
            <nav class="d-flex gap-4 text-muted">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Platform</a>
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted">Policies</a>
                <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-primary">Admin Login</a>
            </nav>
        </div>
    </header>
    <main class="flex-grow-1">
        @RenderBody()
    </main>
    <footer class="border-top py-4 text-center text-muted">
        <small>&copy; @DateTime.UtcNow.Year Attendance Management System. All rights reserved.</small>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
