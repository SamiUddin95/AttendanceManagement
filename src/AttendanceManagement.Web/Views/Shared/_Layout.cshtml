<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Attendance Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
</head>
<body class="public-shell d-flex flex-column min-vh-100">
    <header class="border-bottom py-3 bg-white">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-primary rounded-3 fs-6">AMS</span>
                <div>
                    <div class="fw-bold">Attendance Management System</div>
                    <small class="text-muted">People, schedules &amp; everyday operations</small>
                </div>
            </div>
        </div>
    </header>
    <main class="flex-grow-1" id="main-content" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="border-top py-4 text-center text-muted">
        <small>&copy; @DateTime.UtcNow.Year Attendance Management System. All rights reserved.</small>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
