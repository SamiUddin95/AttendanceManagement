<!DOCTYPE html>
<html lang="en">
@{
    var currentArea = (string?)ViewContext.RouteData.Values["area"] ?? string.Empty;
    var currentController = (string?)ViewContext.RouteData.Values["controller"] ?? string.Empty;
    var currentAction = (string?)ViewContext.RouteData.Values["action"] ?? string.Empty;

    bool IsActive(string? area, string? controller, string? action, string? section = null)
    {
        var areaMatch = string.Equals(currentArea, area ?? string.Empty, StringComparison.OrdinalIgnoreCase);
        var controllerMatch = string.Equals(currentController, controller ?? string.Empty, StringComparison.OrdinalIgnoreCase);
        var actionMatch = string.IsNullOrWhiteSpace(action) || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        var sectionMatch = string.IsNullOrWhiteSpace(section) || string.Equals(Context.Request.Query["section"], section, StringComparison.OrdinalIgnoreCase);
        return areaMatch && controllerMatch && actionMatch && sectionMatch;
    }

    bool IsAdminModuleActive()
    {
        return string.Equals(currentArea, "Administrator", StringComparison.OrdinalIgnoreCase) &&
               string.Equals(currentController, "Dashboard", StringComparison.OrdinalIgnoreCase) &&
               (string.Equals(currentAction, "Lookups", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase));
    }

    var primaryNav = new[]
    {
        new { Title = "Dashboard", Icon = "bi-speedometer2", Area = "Administrator", Controller = "Dashboard", Action = "Index" }
    };

    var adminModules = new List<dynamic>
    {
        new { Title = "Company", Icon = "bi-building-gear", Area = "Administrator", Controller = "Company", Action = "Index" },
        new { Title = "LookUp", Icon = "bi-list-check", Area = "Administrator", Controller = "Dashboard", Action = "Lookups" },
        new { Title = "Shift", Icon = "bi-clock", Area = "Administrator", Controller = "Shift", Action = "Index" },
        new { Title = "Leave Policy", Icon = "bi-calendar-check", Area = "Administrator", Controller = "LeavePolicy", Action = "Index" },
        new { Title = "Leave", Icon = "bi-calendar3", Area = "Administrator", Controller = "Leave", Action = "Index" },
        new { Title = "Employee", Icon = "bi-person-badge", Area = "Administrator", Controller = "Employee", Action = "Index" },
        new { Title = "Group", Icon = "bi-people", Area = "Administrator", Controller = "Group", Action = "Index" },
        new { Title = "Location", Icon = "bi-geo-alt", Area = "Administrator", Controller = "Location", Action = "Index" }
    };

    var otherModules = new List<dynamic>
    {
        new { Title = "Leave", Icon = "bi-calendar-minus", Area = (string?)null, Controller = (string?)null, Action = (string?)null },
        new { Title = "Gen Incharge", Icon = "bi-person-workspace", Area = (string?)null, Controller = (string?)null, Action = (string?)null },
        new { Title = "Gen Employee", Icon = "bi-briefcase", Area = (string?)null, Controller = (string?)null, Action = (string?)null },
        new { Title = "List", Icon = "bi-list-check", Area = (string?)null, Controller = (string?)null, Action = (string?)null },
        new { Title = "Report", Icon = "bi-graph-up", Area = (string?)null, Controller = (string?)null, Action = (string?)null },
        new { Title = "Process", Icon = "bi-arrow-repeat", Area = (string?)null, Controller = (string?)null, Action = (string?)null }
    };
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Attendance Management</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="admin-body">
    <div class="admin-shell">
        <!-- Top Header Bar -->
        <header class="admin-top-header">
            <div class="container-fluid">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <span class="brand-chip">AMS</span>
                        <div>
                            <div class="brand-title">Attendance Management System</div>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="user-info-dropdown d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                            <div class="user-circle">@User?.Identity?.Name?.FirstOrDefault()</div>
                            <div>
                                <div class="fw-semibold">@User?.Identity?.Name</div>
                                <small class="text-muted">Company Admin</small>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <!-- Navigation Bar -->
        <nav class="admin-navbar">
            <div class="container-fluid">
                <div class="d-flex align-items-center">
                    <a asp-area="Administrator" asp-controller="Dashboard" asp-action="Index" class="nav-link @(IsActive("Administrator", "Dashboard", "Index") ? "active" : "")">
                        <i class="bi bi-speedometer2 me-1"></i>Dashboard
                    </a>
                    <div class="nav-divider"></div>
                    @{
                        var adminDropdownActive = adminModules.Any(m => !string.IsNullOrWhiteSpace(m.Controller) && IsActive(m.Area, m.Controller, m.Action, m.GetType().GetProperty("Section")?.GetValue(m) as string));
                    }
                    <div class="dropdown">
                        <button class="nav-link dropdown-toggle @(adminDropdownActive ? "active" : "")" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-grid-1x2-fill me-1"></i>Administrator
                        </button>
                        <ul class="dropdown-menu">
                            @foreach (var item in adminModules)
                            {
                                if (!string.IsNullOrWhiteSpace(item.Controller))
                                {
                                    var section = item.GetType().GetProperty("Section")?.GetValue(item) as string;
                                    var isActive = IsActive(item.Area, item.Controller, item.Action, section);
                                    <li>
                                        <a asp-area="@item.Area"
                                           asp-controller="@item.Controller"
                                           asp-action="@item.Action"
                                           asp-route-section="@(section)"
                                           class="dropdown-item @(isActive ? "active" : "")">
                                            <i class="bi @item.Icon me-2"></i>@item.Title
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a href="#!" class="dropdown-item disabled">
                                            <i class="bi @item.Icon me-2"></i>@item.Title
                                            <small class="text-muted ms-2">(Coming soon)</small>
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                    <div class="nav-divider"></div>
                    <div class="dropdown">
                        <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-calendar-minus me-1"></i>Leave
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a href="#!" class="dropdown-item disabled">
                                    <i class="bi bi-calendar-minus me-2"></i>Leave
                                    <small class="text-muted ms-2">(Coming soon)</small>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-workspace me-1"></i>Gen Incharge
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a href="#!" class="dropdown-item disabled">
                                    <i class="bi bi-person-workspace me-2"></i>Gen Incharge
                                    <small class="text-muted ms-2">(Coming soon)</small>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-briefcase me-1"></i>Gen Employee
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a href="#!" class="dropdown-item disabled">
                                    <i class="bi bi-briefcase me-2"></i>Gen Employee
                                    <small class="text-muted ms-2">(Coming soon)</small>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-list-check me-1"></i>List
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a href="#!" class="dropdown-item disabled">
                                    <i class="bi bi-list-check me-2"></i>List
                                    <small class="text-muted ms-2">(Coming soon)</small>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-graph-up me-1"></i>Report
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a href="#!" class="dropdown-item disabled">
                                    <i class="bi bi-graph-up me-2"></i>Report
                                    <small class="text-muted ms-2">(Coming soon)</small>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="dropdown">
                        <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-arrow-repeat me-1"></i>Process
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a href="#!" class="dropdown-item disabled">
                                    <i class="bi bi-arrow-repeat me-2"></i>Process
                                    <small class="text-muted ms-2">(Coming soon)</small>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="admin-main">
            <div class="container-fluid">
                <div class="page-header mb-4">
                    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                    <small class="text-muted">Attendance Intelligence Hub</small>
                </div>
                <section class="admin-content">
                    @RenderBody()
                </section>
            </div>
            <footer class="admin-footer text-center py-3">
                <small>&copy; @DateTime.UtcNow.Year Attendance Management System</small>
            </footer>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
