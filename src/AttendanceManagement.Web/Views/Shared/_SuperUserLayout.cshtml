<!DOCTYPE html>
<html lang="en">
@{
    var currentArea = (string?)ViewContext.RouteData.Values["area"] ?? string.Empty;
    var currentController = (string?)ViewContext.RouteData.Values["controller"] ?? string.Empty;
    var currentAction = (string?)ViewContext.RouteData.Values["action"] ?? string.Empty;

    bool IsActive(string? area, string? controller, string? action)
    {
        var areaMatch = string.Equals(currentArea, area ?? string.Empty, StringComparison.OrdinalIgnoreCase);
        var controllerMatch = string.Equals(currentController, controller ?? string.Empty, StringComparison.OrdinalIgnoreCase);
        var actionMatch = string.IsNullOrWhiteSpace(action) || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return areaMatch && controllerMatch && actionMatch;
    }

}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Attendance Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
</head>
<body class="admin-body"><a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="admin-shell">
        <!-- Top Header Bar -->
        <header class="admin-top-header">
            <div class="container-fluid">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <button type="button" class="workspace-menu-toggle" aria-controls="workspace-nav" aria-expanded="false" aria-label="Toggle navigation"><span aria-hidden="true">&#9776;</span></button><span class="brand-chip">AMS</span>
                        <div>
                            <div class="brand-title">Attendance Management</div><small class="brand-subtitle">People, schedules &amp; everyday operations</small>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="user-info-dropdown d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                            <div class="user-circle">@User?.Identity?.Name?.FirstOrDefault()</div>
                            <div>
                                <div class="fw-semibold">@User?.Identity?.Name</div>
                                <small class="text-muted">Super User</small>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <!-- Navigation Bar -->
        <nav class="admin-navbar" id="workspace-nav" aria-label="Main navigation"><div class="workspace-nav-label">WORKSPACE</div>
            <div class="container-fluid">
                <div class="d-flex align-items-center">
                    <a asp-area="SuperUser" asp-controller="Dashboard" asp-action="Index" class="nav-link @(IsActive("SuperUser", "Dashboard", "Index") ? "active" : "")">
                        <i class="bi bi-speedometer2 me-1"></i>Dashboard
                    </a>
                    <div class="nav-divider"></div>
                    @await Component.InvokeAsync("ModuleNavigation")
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="admin-main" id="main-content" tabindex="-1">
            <div class="container-fluid">
                @if (ViewData["HidePageHeader"] as bool? != true)
                {
                    <div class="page-header mb-4">
                        <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                        <small class="text-muted">Super User Administration</small>
                    </div>
                }
                <section class="admin-content">
                    @RenderBody()
                </section>
            </div>
            <footer class="admin-footer text-center py-3">
                <small>&copy; @DateTime.UtcNow.Year Attendance Management System</small>
            </footer>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
