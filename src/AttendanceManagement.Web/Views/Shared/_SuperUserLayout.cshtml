<!DOCTYPE html>
<html lang="en">
@{
    var currentArea = (string?)ViewContext.RouteData.Values["area"] ?? string.Empty;
    var currentController = (string?)ViewContext.RouteData.Values["controller"] ?? string.Empty;
    var currentAction = (string?)ViewContext.RouteData.Values["action"] ?? string.Empty;

    bool IsActive(string? area, string? controller, string? action)
    {
        var areaMatch = string.Equals(currentArea, area ?? string.Empty, StringComparison.OrdinalIgnoreCase);
        var controllerMatch = string.Equals(currentController, controller ?? string.Empty, StringComparison.OrdinalIgnoreCase);
        var actionMatch = string.IsNullOrWhiteSpace(action) || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return areaMatch && controllerMatch && actionMatch;
    }

    var superUserModules = new List<dynamic>
    {
        new { Title = "Dashboard", Icon = "bi-speedometer2", Area = "SuperUser", Controller = "Dashboard", Action = "Index" },
        new { Title = "Role", Icon = "bi-shield-lock", Area = "SuperUser", Controller = "Role", Action = "Index" },
        new { Title = "Assign Role", Icon = "bi-person-badge", Area = "SuperUser", Controller = "AssignRole", Action = "Index" },
        new { Title = "Module", Icon = "bi-grid", Area = "SuperUser", Controller = "Module", Action = "Index" }
    };
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Attendance Management</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="admin-body">
    <div class="admin-shell">
        <!-- Top Header Bar -->
        <header class="admin-top-header">
            <div class="container-fluid">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-3">
                        <span class="brand-chip">AMS</span>
                        <div>
                            <div class="brand-title">Attendance Management System</div>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="user-info-dropdown d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                            <div class="user-circle">@User?.Identity?.Name?.FirstOrDefault()</div>
                            <div>
                                <div class="fw-semibold">@User?.Identity?.Name</div>
                                <small class="text-muted">Super User</small>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>

        <!-- Navigation Bar -->
        <nav class="admin-navbar">
            <div class="container-fluid">
                <div class="d-flex align-items-center">
                    <a asp-area="SuperUser" asp-controller="Dashboard" asp-action="Index" class="nav-link @(IsActive("SuperUser", "Dashboard", "Index") ? "active" : "")">
                        <i class="bi bi-speedometer2 me-1"></i>Dashboard
                    </a>
                    <div class="nav-divider"></div>
                    @await Component.InvokeAsync("ModuleNavigation")
                    <div class="nav-divider"></div>
                    <div class="dropdown">
                        <button class="nav-link dropdown-toggle @(superUserModules.Any(m => IsActive(m.Area, m.Controller, m.Action)) ? "active" : "")" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-shield-lock me-1"></i>Super User
                        </button>
                        <ul class="dropdown-menu">
                            @foreach (var item in superUserModules)
                            {
                                if (!string.IsNullOrWhiteSpace(item.Controller))
                                {
                                    var isActive = IsActive(item.Area, item.Controller, item.Action);
                                    <li>
                                        <a asp-area="@item.Area"
                                           asp-controller="@item.Controller"
                                           asp-action="@item.Action"
                                           class="dropdown-item @(isActive ? "active" : "")">
                                            <i class="bi @item.Icon me-2"></i>@item.Title
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a href="#!" class="dropdown-item disabled">
                                            <i class="bi @item.Icon me-2"></i>@item.Title
                                            <small class="text-muted ms-2">(Coming soon)</small>
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <main class="admin-main">
            <div class="container-fluid">
                <div class="page-header mb-4">
                    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
                    <small class="text-muted">Super User Administration</small>
                </div>
                <section class="admin-content">
                    @RenderBody()
                </section>
            </div>
            <footer class="admin-footer text-center py-3">
                <small>&copy; @DateTime.UtcNow.Year Attendance Management System</small>
            </footer>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
