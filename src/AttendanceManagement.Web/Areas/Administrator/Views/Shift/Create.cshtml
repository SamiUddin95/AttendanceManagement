@model AttendanceManagement.Web.ViewModels.Shifts.ShiftViewModel
@{
    ViewData["Title"] = "Create Shift";
    ViewData["HidePageHeader"] = true;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">Create Shift</h2>
        <small class="text-muted">Configure shift schedule and timing</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="CompanyId" class="form-label">Company</label>
                        <input type="text" class="form-control" value="@(ViewBag.CompanyName ?? "Default Company")" disabled />
                        <input type="hidden" asp-for="CompanyId" value="@(ViewBag.CompanyId ?? Guid.Empty)" />
                        <small class="text-muted">Company is read-only</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Shift Name</label>
                        <input asp-for="Name" class="form-control" required maxlength="150" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" maxlength="500"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <div class="form-check form-switch">
                    <input type="checkbox" class="form-check-input" asp-for="IsActive" checked />
                    <label class="form-check-label">Active</label>
                </div>
            </div>

            <partial name="_WeeklySchedule" model="Model" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Create Shift</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/shift-schedule.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/shift-schedule.js" asp-append-version="true"></script>
}
