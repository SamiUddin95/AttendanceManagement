@model AttendanceManagement.Web.ViewModels.LeaveHistory.LeaveHistoryViewModel
@{
    ViewData["Title"] = "Leave History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">Leave History</h2>
        <small class="text-muted">View your leave application history</small>
    </div>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Employee Info Card -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light py-3">
        <h5 class="mb-0"><i class="bi bi-person me-2 text-primary"></i>Employee Information</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <strong>Employee Name:</strong> @Model.EmployeeName
            </div>
            <div class="col-md-4">
                <strong>Employee No:</strong> @Model.EmployeeNo
            </div>
            <div class="col-md-4">
                <strong>Total Applications:</strong> @Model.LeaveHistoryItems.Count
            </div>
        </div>
    </div>
</div>

<!-- Leave History Table -->
<div class="card shadow-sm">
    <div class="card-header bg-light py-3">
        <h5 class="mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Leave Applications</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.LeaveHistoryItems.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Leave ID</th>
                            <th>Type</th>
                            <th>Date Applied</th>
                            <th>From</th>
                            <th>To</th>
                            <th>Days</th>
                            <th>Status</th>
                            <th>Modified Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.LeaveHistoryItems)
                        {
                            <tr>
                                <td class="fw-semibold">@item.LeaveId</td>
                                <td>
                                    <span class="badge bg-info-subtle text-info">@item.LeaveType</span>
                                </td>
                                <td>@item.DateApplied.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@item.FromDate.ToString("dd MMM yyyy")</td>
                                <td>@item.ToDate.ToString("dd MMM yyyy")</td>
                                <td class="text-center">@item.TotalDays</td>
                                <td>
                                    @{
                                        var statusClass = item.Status switch
                                        {
                                            "Approved" => "bg-success",
                                            "Rejected" => "bg-danger",
                                            "Cancelled" => "bg-secondary",
                                            _ => "bg-warning"
                                        };
                                    }
                                    <span class="badge @statusClass">@item.Status</span>
                                </td>
                                <td>
                                    @if (item.ModifiedDate.HasValue)
                                    {
                                        <span class="small">@item.ModifiedDate.Value.ToString("dd MMM yyyy HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    <p class="mb-0">No leave applications found</p>
                    <small class="text-muted">Your leave history will appear here</small>
                </div>
            </div>
        }
    </div>
</div>
