@model AttendanceManagement.Web.ViewModels.Locations.LocationViewModel
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Location" : "Create Location";
}

<div class="d-flex justify-content-between align-items-center mb-4">
   @*  <div>
        <h2 class="h4 mb-1">@(Model.Id > 0 ? "Edit Location" : "Create Location")</h2>
        <small class="text-muted">Configure location details and contact information</small>
    </div> *@
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Back to List
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="@(Model.Id > 0 ? "Edit" : "Create")" method="post">
            @Html.AntiForgeryToken()
            @if (Model.Id > 0)
            {
                <input type="hidden" asp-for="Id" />
            }

            <div class="row g-4">
                <div class="col-md-12">
                    <label asp-for="Name" class="form-label">Location Name</label>
                    <input asp-for="Name" class="form-control" required maxlength="150" placeholder="e.g., Main Office, Branch Office, Warehouse" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Address" class="form-label">Address</label>
                    <textarea asp-for="Address" class="form-control" rows="3" maxlength="500" placeholder="Street address, building name, etc."></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="City" class="form-label">City</label>
                    <input asp-for="City" class="form-control" maxlength="100" placeholder="e.g., Karachi, Dubai, Riyadh" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Country" class="form-label">Country</label>
                    <input asp-for="Country" class="form-control" maxlength="100" placeholder="e.g., Pakistan, UAE, Saudi Arabia" />
                    <span asp-validation-for="Country" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PostalCode" class="form-label">Postal Code</label>
                    <input asp-for="PostalCode" class="form-control" maxlength="20" placeholder="e.g., 75000, 12345" />
                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control" maxlength="25" placeholder="e.g., +92 21 1234567" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label">Active</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-2"></i>@(Model.Id > 0 ? "Update Location" : "Create Location")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
