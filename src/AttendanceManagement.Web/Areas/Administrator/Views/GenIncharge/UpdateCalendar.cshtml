@model AttendanceManagement.Web.ViewModels.GenIncharge.UpdateCalendarViewModel
@{
    ViewData["Title"] = "Update Calendar";
    var statusColors = new Dictionary<string, (string bg, string text)>
    {
        ["Working"]    = ("bg-success",         "text-white"),
        ["Off"]        = ("bg-secondary",        "text-white"),
        ["Sunday"]     = ("bg-primary",          "text-white"),
        ["Gazetted"]   = ("bg-warning",          "text-dark"),
        ["Provincial"] = ("bg-info",             "text-dark"),
        ["Strike"]     = ("bg-danger",           "text-white"),
    };
}

@if (TempData["SuccessMessage"] is string successMsg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@successMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMsg)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a asp-area="Administrator" asp-controller="Dashboard" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item">Incharge</li>
        <li class="breadcrumb-item active" aria-current="page">Update Calendar</li>
    </ol>
</nav>

<!-- ═══════════════════  FILTER FORM  ═══════════════════ -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light py-3">
        <h5 class="mb-0 fw-semibold">
            <i class="bi bi-calendar3 me-2 text-primary"></i>Employee Calendar
        </h5>
    </div>
    <div class="card-body">
        <form method="get" asp-action="UpdateCalendar" id="calendarFilter" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label for="fYear" class="form-label fw-semibold">Year</label>
                <select name="year" id="fYear" class="form-select js-autoload">
                    @foreach (var y in Model.AvailableYears)
                    {
                        if (Model.SelectedYear == y)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="fMonth" class="form-label fw-semibold">Month</label>
                <select name="month" id="fMonth" class="form-select js-autoload">
                    @foreach (var m in Model.AvailableMonths)
                    {
                        if (Model.SelectedMonth == m.Value)
                        {
                            <option value="@m.Value" selected>@m.Name</option>
                        }
                        else
                        {
                            <option value="@m.Value">@m.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label for="fEmployee" class="form-label fw-semibold">
                    Employee <span class="text-danger">*</span>
                </label>
                <select name="employeeId" id="fEmployee" class="form-select js-autoload" required
                        asp-items="Model.EmployeeOptions">
                    <option value="">— Select a team member —</option>
                </select>
            </div>
            <div class="col-md-3">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="chkSelectWorking"
                           @(Model.HasCalendar ? "" : "disabled")>
                    <label class="form-check-label fw-semibold" for="chkSelectWorking"
                           title="Mark every non-weekly-off day as Working">Select Working</label>
                </div>
                <noscript><button type="submit" class="btn btn-primary btn-sm">Load</button></noscript>
            </div>
        </form>
    </div>
</div>

@if (!Model.HasCalendar)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-calendar3 fs-1 d-block mb-3 text-primary opacity-50"></i>
            <h5 class="fw-semibold">Select an Employee</h5>
            <p class="mb-0 small">Choose a year, month and team member — the calendar loads automatically.</p>
        </div>
    </div>
}
else
{
    <!-- ═══════════════════  EMPLOYEE HEADER  ═══════════════════ -->
    <div class="card shadow-sm mb-4 border-0"
         style="background: linear-gradient(135deg,#1e3a5f 0%,#2d6a9f 100%);">
        <div class="card-body py-3 text-white">
            <div class="row align-items-center g-3">
                <div class="col-auto">
                    <div class="rounded-circle bg-white bg-opacity-25 d-flex align-items-center
                                justify-content-center" style="width:52px;height:52px;">
                        <span class="fw-bold fs-5 text-white">
                            @Model.EmployeeName!.Substring(0, Math.Min(2, Model.EmployeeName.Length)).ToUpper()
                        </span>
                    </div>
                </div>
                <div class="col">
                    <div class="fw-bold fs-5">@Model.EmployeeName</div>
                    <div class="small opacity-75">
                        <i class="bi bi-person-badge me-1"></i>@Model.EmployeeNo
                        @if (!string.IsNullOrWhiteSpace(Model.Department))
                        {
                            <span class="ms-2"><i class="bi bi-building me-1"></i>@Model.Department</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Designation))
                        {
                            <span class="ms-2"><i class="bi bi-briefcase me-1"></i>@Model.Designation</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ShiftName))
                        {
                            <span class="ms-2"><i class="bi bi-clock me-1"></i>@Model.ShiftName</span>
                        }
                    </div>
                </div>
                <div class="col-auto">
                    <span class="badge bg-white bg-opacity-25 px-3 py-2 fs-6">
                        <i class="bi bi-calendar-month me-2"></i>@Model.MonthYearDisplay
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════  STATUS LEGEND  ═══════════════════ -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-3">
            <div class="d-flex flex-wrap align-items-center gap-3">
                <span class="fw-semibold text-muted small me-1">
                    <i class="bi bi-info-circle me-1"></i>Legend:
                </span>
                @foreach (var (status, (bg, fg)) in statusColors)
                {
                    <span class="badge @bg @fg px-3 py-2">@status</span>
                }
                <span class="small text-muted">
                    <i class="bi bi-pencil-fill text-warning me-1"></i>Changed from default
                </span>
                <div class="ms-auto">
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            id="btnResetDefaults" title="Restore defaults from the employee's shift and mark days">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Defaults
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════  CALENDAR SAVE FORM  ═══════════════════ -->
    <form asp-action="SaveCalendar" method="post" id="calendarForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="employeeId" value="@Model.SelectedEmployeeId" />
        <input type="hidden" name="month"      value="@Model.SelectedMonth" />
        <input type="hidden" name="year"       value="@Model.SelectedYear" />

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-pencil-square me-2"></i>@Model.MonthYearDisplay — Daily Status
                    </h5>
                    <small class="opacity-75">
                        @Model.CalendarDays.Count days · <span id="overrideCount">@Model.OverriddenCount</span> changed from default
                    </small>
                </div>
            </div>

            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle mb-0"
                           style="min-width:900px; table-layout:fixed;">
                        <thead class="table-dark">
                            <tr>
                                @foreach (var dow in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                                {
                                    <th class="text-center py-2">@dow</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var firstDay     = new DateTime(Model.SelectedYear, Model.SelectedMonth, 1);
                                var startOffset  = (int)firstDay.DayOfWeek; // 0=Sun … 6=Sat
                                var allDays      = Model.CalendarDays;
                                int totalRows    = (int)Math.Ceiling((startOffset + allDays.Count) / 7.0);
                                int dayIndex     = 0;
                                var todayDate    = DateTime.Today;
                            }
                            @for (int row = 0; row < totalRows; row++)
                            {
                                <tr>
                                    @for (int col = 0; col < 7; col++)
                                    {
                                        int cellIndex = row * 7 + col;
                                        if (cellIndex < startOffset || dayIndex >= allDays.Count)
                                        {
                                            <td class="bg-light" style="height:96px;"></td>
                                            continue;
                                        }

                                        var entry = allDays[dayIndex++];
                                        var isSun = entry.IsSunday;
                                        var (sbg, sfg) = statusColors.TryGetValue(entry.DayStatus, out var sc)
                                            ? sc : ("bg-secondary", "text-white");
                                        var defaultTip = $"Default: {entry.DefaultStatus}" +
                                                         (string.IsNullOrWhiteSpace(entry.DefaultSource) ? "" : $" ({entry.DefaultSource})");
                                        <td class="p-2 day-cell @(isSun ? "bg-primary bg-opacity-10" : "") @(entry.Date == todayDate ? "border border-2 border-primary" : "")"
                                            style="height:96px; vertical-align:top;" title="@defaultTip">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <span class="fw-bold @(isSun ? "text-primary" : "text-dark")">
                                                    @entry.Date.Day.ToString("D2")
                                                    <i class="bi bi-pencil-fill text-warning ms-1 override-mark @(entry.IsOverridden ? "" : "d-none")"
                                                       style="font-size:.65rem;"></i>
                                                </span>
                                                <span class="badge status-badge @sbg @sfg" style="font-size:0.62rem;">
                                                    @entry.DayStatus
                                                </span>
                                            </div>
                                            <select name="status_@entry.DateKey"
                                                    class="form-select form-select-sm status-select mt-1"
                                                    data-default="@entry.DefaultStatus"
                                                    data-initial="@entry.DayStatus"
                                                    aria-label="Status for @entry.Date.ToString("dd MMM yyyy")"
                                                    style="font-size:0.75rem;">
                                                @foreach (var opt in entry.StatusOptions)
                                                {
                                                    if (entry.DayStatus == opt)
                                                    {
                                                        <option value="@opt" selected>@opt</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@opt">@opt</option>
                                                    }
                                                }
                                            </select>
                                            @if (!string.IsNullOrWhiteSpace(entry.DefaultSource) && entry.DefaultStatus is not ("Working" or "Sunday"))
                                            {
                                                <div class="text-muted text-truncate mt-1" style="font-size:.65rem;">
                                                    <i class="bi bi-flag-fill me-1"></i>@entry.DefaultSource
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer bg-light py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="d-flex flex-wrap gap-3 small text-muted" id="summaryBar"></div>
                    <div class="d-flex align-items-center gap-2">
                        <span id="dirtyBadge" class="badge bg-warning text-dark d-none">Unsaved changes</span>
                        <button type="submit" class="btn btn-success px-5" id="btnUpdate">
                            <i class="bi bi-save me-2"></i>Update
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
}

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const filterForm = document.getElementById('calendarFilter');
    const selects    = Array.from(document.querySelectorAll('.status-select'));
    const isDirty    = () => selects.some(s => s.value !== s.dataset.initial);
    let submitting   = false;

    // ── Auto-load when Year / Month / Employee changes ─────────────────────
    document.querySelectorAll('.js-autoload').forEach(el => {
        el.addEventListener('change', function () {
            if (!document.getElementById('fEmployee').value) return;
            if (isDirty() && !confirm('You have unsaved changes. Discard them and load another calendar?')) {
                this.value = this.querySelector('option[selected]')?.value ?? this.value;
                return;
            }
            submitting = true;
            filterForm.submit();
        });
    });

    if (!selects.length) return;

    const badgeMap = {
        Working:    ['bg-success',   'text-white'],
        Off:        ['bg-secondary', 'text-white'],
        Sunday:     ['bg-primary',   'text-white'],
        Gazetted:   ['bg-warning',   'text-dark'],
        Provincial: ['bg-info',      'text-dark'],
        Strike:     ['bg-danger',    'text-white'],
    };
    const textMap = { Working:'text-success', Off:'text-secondary', Sunday:'text-primary',
                      Gazetted:'text-warning', Provincial:'text-info', Strike:'text-danger' };

    const summaryBar    = document.getElementById('summaryBar');
    const overrideCount = document.getElementById('overrideCount');
    const dirtyBadge    = document.getElementById('dirtyBadge');
    const chkWorking    = document.getElementById('chkSelectWorking');

    function refreshCell(sel) {
        const cell  = sel.closest('td');
        const badge = cell.querySelector('.status-badge');
        badge.className = 'badge status-badge ' + (badgeMap[sel.value] || badgeMap.Off).join(' ');
        badge.textContent = sel.value;
        cell.querySelector('.override-mark').classList.toggle('d-none', sel.value === sel.dataset.default);
    }

    function refreshSummary() {
        const counts = {};
        selects.forEach(s => { counts[s.value] = (counts[s.value] || 0) + 1; });
        summaryBar.innerHTML = Object.entries(counts)
            .map(([k, v]) => `<span class="${textMap[k] || 'text-muted'} fw-semibold">
                                <i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>${k}: ${v}
                              </span>`)
            .join('');
        overrideCount.textContent = selects.filter(s => s.value !== s.dataset.default).length;
        dirtyBadge.classList.toggle('d-none', !isDirty());
    }

    function setValue(sel, value) {
        if (!Array.from(sel.options).some(o => o.value === value)) return;
        sel.value = value;
        refreshCell(sel);
    }

    selects.forEach(sel => sel.addEventListener('change', function () {
        refreshCell(this);
        refreshSummary();
    }));

    // ── Select Working: mark all non weekly-off days as Working (restorable) ─
    chkWorking.addEventListener('change', function () {
        selects.forEach(sel => {
            if (sel.dataset.default === 'Sunday') return;
            if (this.checked) {
                sel.dataset.prev = sel.value;
                setValue(sel, 'Working');
            } else if (sel.dataset.prev) {
                setValue(sel, sel.dataset.prev);
                delete sel.dataset.prev;
            }
        });
        refreshSummary();
    });

    document.getElementById('btnResetDefaults').addEventListener('click', function () {
        selects.forEach(sel => setValue(sel, sel.dataset.default));
        chkWorking.checked = false;
        refreshSummary();
    });

    document.getElementById('calendarForm').addEventListener('submit', function () {
        submitting = true;
        const btn = document.getElementById('btnUpdate');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Updating…';
    });

    window.addEventListener('beforeunload', function (e) {
        if (!submitting && isDirty()) { e.preventDefault(); e.returnValue = ''; }
    });

    refreshSummary();
});
</script>
}
