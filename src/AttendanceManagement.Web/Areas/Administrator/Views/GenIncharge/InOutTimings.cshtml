@model AttendanceManagement.Web.ViewModels.GenIncharge.InchargeInOutTimingsViewModel
@{
    ViewData["Title"] = "In Out Timings";
    var hasEmployee = Model.SelectedEmployeeId.HasValue;
    var hasData = Model.InOutTimingsItems.Any();
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="InOutTimings" method="post">
    @Html.AntiForgeryToken()

    <!-- Employee Selector Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-3">
            <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Select Employee</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Team Member <span class="text-danger">*</span></label>
                    <select name="SelectedEmployeeId" class="form-select" required asp-items="Model.EmployeeOptions">
                        <option value="">-- Select a team member --</option>
                    </select>
                    <div class="form-text">Only your assigned employees are listed</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Month</label>
                    <select name="SelectedMonth" class="form-select">
                        @foreach (var m in Model.AvailableMonths)
                        {
                            if (Model.SelectedMonth == m.Value)
                            {
                                <option value="@m.Value" selected>@m.Name</option>
                            }
                            else
                            {
                                <option value="@m.Value">@m.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Year</label>
                    <select name="SelectedYear" class="form-select">
                        @foreach (var y in Model.AvailableYears)
                        {
                            if (Model.SelectedYear == y)
                            {
                                <option value="@y" selected>@y</option>
                            }
                            else
                            {
                                <option value="@y">@y</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100" title="Generate Report">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>

            <!-- Report Type -->
            <div class="row g-3 mt-1">
                <div class="col-12">
                    <label class="form-label fw-semibold mb-2">Report Type</label>
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="payrollWise" name="IsPayrollWise"
                                   @(Model.IsPayrollWise ? "checked" : "") value="true" />
                            <label class="form-check-label" for="payrollWise">
                                <i class="bi bi-calculator me-1"></i>Payroll Wise
                            </label>
                            <input type="hidden" name="IsPayrollWise" value="false" />
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="monthWise" name="IsMonthWise"
                                   @(Model.IsMonthWise ? "checked" : "") value="true" />
                            <label class="form-check-label" for="monthWise">
                                <i class="bi bi-calendar-month me-1"></i>Month Wise
                            </label>
                            <input type="hidden" name="IsMonthWise" value="false" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@if (hasEmployee)
{
    <!-- Selected Employee Info -->
    <div class="card shadow-sm mb-4 border-primary border-opacity-25">
        <div class="card-body py-3">
            <div class="row align-items-center">
                <div class="col-auto">
                    <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center"
                         style="width:52px;height:52px;">
                        <span class="fw-bold text-primary fs-5">
                            @Model.SelectedEmployeeName![..Math.Min(2, Model.SelectedEmployeeName.Length)].ToUpper()
                        </span>
                    </div>
                </div>
                <div class="col">
                    <div class="fw-bold fs-5">@Model.SelectedEmployeeName</div>
                    <div class="text-muted small">
                        @Model.SelectedEmployeeNo
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedEmployeeDept))
                        {
                            <span class="mx-1">·</span><span>@Model.SelectedEmployeeDept</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedEmployeeDesignation))
                        {
                            <span class="mx-1">·</span><span>@Model.SelectedEmployeeDesignation</span>
                        }
                    </div>
                </div>
                <div class="col-auto">
                    <span class="badge bg-info-subtle text-info fs-6">
                        <i class="bi bi-calendar me-1"></i>@Model.MonthYearDisplay
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary ms-1">@Model.ReportTypeDisplay</span>
                </div>
            </div>
        </div>
    </div>

    @if (hasData)
    {
        <!-- Summary Stats -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card shadow-sm text-center border-0 bg-primary bg-opacity-10 h-100">
                    <div class="card-body py-3">
                        <div class="fs-3 fw-bold text-primary">@Model.InOutTimingsItems.Count</div>
                        <div class="small text-muted">Total Days</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm text-center border-0 bg-success bg-opacity-10 h-100">
                    <div class="card-body py-3">
                        <div class="fs-3 fw-bold text-success">@Model.PresentCount</div>
                        <div class="small text-muted">Present</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm text-center border-0 bg-danger bg-opacity-10 h-100">
                    <div class="card-body py-3">
                        <div class="fs-3 fw-bold text-danger">@Model.AbsentCount</div>
                        <div class="small text-muted">Absent</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card shadow-sm text-center border-0 bg-warning bg-opacity-10 h-100">
                    <div class="card-body py-3">
                        <div class="fs-3 fw-bold text-warning">@Model.HalfDayCount</div>
                        <div class="small text-muted">Half Day</div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.TotalExtraHours > TimeSpan.Zero)
        {
            <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-clock-history me-2 fs-5"></i>
                Total overtime this month: <strong class="ms-1">@Model.TotalExtraHours.ToString(@"hh\:mm")</strong> hrs
            </div>
        }

        <!-- Report Header -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-primary text-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">
                            <i class="bi bi-clock-history me-2"></i>In/Out Report — @Model.SelectedEmployeeName
                        </h5>
                        <small>@Model.MonthYearDisplay &bull; @Model.ReportTypeDisplay</small>
                    </div>
                    <span class="badge bg-light text-dark fs-6">@Model.InOutTimingsItems.Count records</span>
                </div>
            </div>
        </div>

        <!-- In/Out Table -->
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:55px;" class="text-center">Sr#</th>
                                <th>Date</th>
                                <th style="width:140px;">
                                    <i class="bi bi-box-arrow-in-right text-success me-1"></i>Time In
                                </th>
                                <th style="width:140px;">
                                    <i class="bi bi-box-arrow-right text-danger me-1"></i>Time Out
                                </th>
                                <th style="width:140px;">
                                    <i class="bi bi-hourglass-split text-warning me-1"></i>Extra Hours
                                </th>
                                <th style="width:170px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.InOutTimingsItems)
                            {
                                var rowClass = item.Status switch
                                {
                                    "Absent"           => "table-danger",
                                    "Half Day"         => "table-warning",
                                    "Half Day (No Out)"=> "table-warning",
                                    "Half Day (No In)" => "table-warning",
                                    _                  => ""
                                };
                                <tr class="@rowClass">
                                    <td class="text-center fw-semibold text-muted">@item.SrNo</td>
                                    <td>
                                        <div class="fw-semibold">@item.Date.ToString("dd MMM yyyy")</div>
                                        <small class="text-muted">@item.Date.DayOfWeek</small>
                                    </td>
                                    <td>
                                        @if (item.TimeIn.HasValue)
                                        {
                                            <span class="fw-semibold text-success">
                                                <i class="bi bi-arrow-right-circle me-1"></i>
                                                @item.TimeIn.Value.ToString(@"hh\:mm")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">--:--</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.TimeOut.HasValue)
                                        {
                                            <span class="fw-semibold text-danger">
                                                <i class="bi bi-arrow-left-circle me-1"></i>
                                                @item.TimeOut.Value.ToString(@"hh\:mm")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">--:--</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.ExtraHours.HasValue && item.ExtraHours.Value > TimeSpan.Zero)
                                        {
                                            <span class="badge bg-warning text-dark fw-semibold">
                                                <i class="bi bi-plus-circle me-1"></i>
                                                @item.ExtraHours.Value.ToString(@"hh\:mm")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var (badgeClass, icon) = item.Status switch
                                            {
                                                "Present"            => ("bg-success", "bi-check-circle-fill"),
                                                "Absent"             => ("bg-danger",  "bi-x-circle-fill"),
                                                "Half Day"           => ("bg-warning text-dark", "bi-dash-circle-fill"),
                                                "Half Day (No Out)"  => ("bg-info text-dark",    "bi-arrow-right-circle-fill"),
                                                "Half Day (No In)"   => ("bg-info text-dark",    "bi-arrow-left-circle-fill"),
                                                _                    => ("bg-secondary",          "bi-question-circle")
                                            };
                                        }
                                        <span class="badge @badgeClass">
                                            <i class="bi @icon me-1"></i>@item.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-semibold">
                            <tr>
                                <td colspan="2">Totals</td>
                                <td colspan="2"></td>
                                <td>
                                    @if (Model.TotalExtraHours > TimeSpan.Zero)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @Model.TotalExtraHours.ToString(@"hh\:mm") total
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-success me-1">@Model.PresentCount P</span>
                                    <span class="badge bg-danger me-1">@Model.AbsentCount A</span>
                                    <span class="badge bg-warning text-dark">@Model.HalfDayCount HD</span>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                <p class="mb-0">No attendance records found for <strong>@Model.SelectedEmployeeName</strong></p>
                <small>in @Model.MonthYearDisplay</small>
            </div>
        </div>
    }
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-person-lines-fill fs-1 d-block mb-3 text-primary opacity-50"></i>
            <h5 class="fw-semibold">Select a Team Member</h5>
            <p class="mb-0 small">Choose an employee and click the search button to generate the In/Out timings report.</p>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const payrollWise = document.getElementById('payrollWise');
            const monthWise = document.getElementById('monthWise');
            if (payrollWise && monthWise) {
                payrollWise.addEventListener('change', function () { if (this.checked) monthWise.checked = false; });
                monthWise.addEventListener('change', function () { if (this.checked) payrollWise.checked = false; });
            }
        });
    </script>
}
