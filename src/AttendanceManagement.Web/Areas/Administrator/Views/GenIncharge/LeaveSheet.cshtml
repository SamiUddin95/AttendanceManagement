@model AttendanceManagement.Web.ViewModels.GenIncharge.LeaveSheetViewModel
@{
    ViewData["Title"] = "Leave Sheet";
    var hasResult = !string.IsNullOrEmpty(Model.EmployeeName);
}

@if (TempData["ErrorMessage"] is string errMsg)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@errMsg
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ═══════════════════════  FILTER CARD  ═══════════════════════ -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light py-3 d-flex align-items-center justify-content-between">
        <h5 class="mb-0 fw-semibold">
            <i class="bi bi-funnel me-2 text-primary"></i>Leave Sheet Filter
        </h5>
        @if (hasResult)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary d-print-none" onclick="window.print()">
                <i class="bi bi-printer me-1"></i>Print
            </button>
        }
    </div>
    <div class="card-body">
        <form asp-action="LeaveSheet" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()

            <div class="col-md-7">
                <label class="form-label fw-semibold">
                    Employee <span class="text-danger">*</span>
                </label>
                <select name="SelectedEmployeeId" class="form-select" required
                        asp-items="Model.EmployeeOptions">
                    <option value="">— Select a team member —</option>
                </select>
                <span asp-validation-for="SelectedEmployeeId" class="text-danger small"></span>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold">Year</label>
                <select name="SelectedYear" class="form-select">
                    @foreach (var y in Model.AvailableYears)
                    {
                        if (Model.SelectedYear == y)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i>Generate
                </button>
            </div>
        </form>
    </div>
</div>

@if (!hasResult)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="bi bi-file-earmark-person fs-1 d-block mb-3 text-primary opacity-50"></i>
            <h5 class="fw-semibold">Select an Employee &amp; Period</h5>
            <p class="mb-0 small">
                Choose a team member and date range, then click
                <strong>Search</strong> to generate the leave sheet.
            </p>
        </div>
    </div>
}
else
{
    <!-- ═══════════════════════  EMPLOYEE HEADER  ═══════════════════════ -->
    <div class="card shadow-sm mb-4 border-0"
         style="background: linear-gradient(135deg, #1e3a5f 0%, #2d6a9f 100%);">
        <div class="card-body py-4 text-white">
            <div class="row align-items-center">
                <div class="col-auto">
                    <div class="rounded-circle bg-white bg-opacity-25 d-flex align-items-center
                                justify-content-center shadow"
                         style="width:64px; height:64px;">
                        <span class="fw-bold fs-4 text-white">
                            @Model.EmployeeName!.Substring(0, Math.Min(2, Model.EmployeeName.Length)).ToUpper()
                        </span>
                    </div>
                </div>
                <div class="col">
                    <h4 class="mb-0 fw-bold">@Model.EmployeeName</h4>
                    <div class="opacity-75 small mt-1">
                        <span><i class="bi bi-person-badge me-1"></i>@Model.EmployeeNo</span>
                        @if (!string.IsNullOrWhiteSpace(Model.Department))
                        {
                            <span class="ms-3"><i class="bi bi-building me-1"></i>@Model.Department</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Designation))
                        {
                            <span class="ms-3"><i class="bi bi-briefcase me-1"></i>@Model.Designation</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.EmployeeType))
                        {
                            <span class="ms-3"><i class="bi bi-tag me-1"></i>@Model.EmployeeType</span>
                        }
                    </div>
                </div>
                <div class="col-auto text-end">
                    <div class="badge bg-white bg-opacity-25 px-3 py-2 fs-6">
                        <i class="bi bi-calendar-range me-2"></i>@Model.PeriodDisplay
                    </div>
                    @if (Model.JoiningDate.HasValue)
                    {
                        <div class="small opacity-75 mt-2">
                            <i class="bi bi-calendar-check me-1"></i>
                            Joined: @Model.JoiningDate.Value.ToString("dd MMM yyyy")
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════  SUMMARY CARDS  ═══════════════════════ -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100 text-center"
                 style="background: linear-gradient(135deg,#e8f4ff,#d0e9ff);">
                <div class="card-body py-3">
                    <div class="fs-2 fw-bold text-primary">@Model.Rows.Count</div>
                    <div class="small text-muted fw-semibold">Leave Types</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100 text-center"
                 style="background: linear-gradient(135deg,#e8fff0,#ccf5e0);">
                <div class="card-body py-3">
                    <div class="fs-2 fw-bold text-success">@Model.TotalAllowed</div>
                    <div class="small text-muted fw-semibold">Total Allowed</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm border-0 h-100 text-center"
                 style="background: linear-gradient(135deg,#fff8e8,#ffecc0);">
                <div class="card-body py-3">
                    <div class="fs-2 fw-bold text-warning">@Model.TotalTaken</div>
                    <div class="small text-muted fw-semibold">Total Taken</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            @{
                var totalBalClass = Model.TotalBalance > 5 ? "text-success" :
                                    Model.TotalBalance > 0 ? "text-warning"  : "text-danger";
                var totalBalBg    = Model.TotalBalance > 5
                    ? "background:linear-gradient(135deg,#e8fff0,#ccf5e0);"
                    : Model.TotalBalance > 0
                        ? "background:linear-gradient(135deg,#fff8e8,#ffecc0);"
                        : "background:linear-gradient(135deg,#ffe8e8,#ffc0c0);";
            }
            <div class="card shadow-sm border-0 h-100 text-center" style="@totalBalBg">
                <div class="card-body py-3">
                    <div class="fs-2 fw-bold @totalBalClass">@Model.TotalBalance</div>
                    <div class="small text-muted fw-semibold">Total Balance</div>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Rows.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                <p class="mb-0">
                    No approved leave records found for <strong>@Model.EmployeeName</strong>
                    in the selected period.
                </p>
            </div>
        </div>
    }
    else
    {
        <!-- ═══════════════════════  LEAVE SHEET TABLE  ═══════════════════════ -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-table me-2"></i>Leave Sheet — @Model.EmployeeName
                    </h5>
                    <small class="opacity-75">@Model.PeriodDisplay</small>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:50px;" class="text-center text-muted">#</th>
                                <th>Leave Type</th>
                                <th style="width:130px;" class="text-center">
                                    <i class="bi bi-check-circle text-success me-1"></i>Allowed
                                </th>
                                <th style="width:130px;" class="text-center">
                                    <i class="bi bi-dash-circle text-warning me-1"></i>Taken
                                </th>
                                <th style="width:130px;" class="text-center">
                                    <i class="bi bi-wallet2 text-primary me-1"></i>Balance
                                </th>
                                <th style="width:180px;">Utilization</th>
                                <th style="width:100px;" class="text-center">Carry Fwd</th>
                                <th style="width:60px;" class="text-center d-print-none">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                                var row = Model.Rows[i];
                                var pct = row.UtilizationPct;
                                var barClass  = pct >= 100 ? "bg-danger"  :
                                                pct >= 75  ? "bg-warning" :
                                                pct >= 50  ? "bg-info"    : "bg-success";
                                var balBadge  = row.Balance > 5  ? "bg-success" :
                                                row.Balance > 0  ? "bg-warning text-dark" :
                                                row.Taken   > 0  ? "bg-danger"  : "bg-secondary";
                                <tr>
                                    <td class="text-center text-muted fw-semibold">@(i + 1)</td>
                                    <td>
                                        <span class="fw-semibold">@row.LeaveType</span>
                                        @if (row.OverUsed > 0)
                                        {
                                            <span class="badge bg-danger ms-2 small">
                                                <i class="bi bi-exclamation-triangle me-1"></i>
                                                Over by @row.OverUsed day(s)
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-success
                                                     border border-success-subtle fw-semibold px-3 py-2">
                                            @row.Allowed
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-warning-subtle text-warning
                                                     border border-warning-subtle fw-semibold px-3 py-2">
                                            @row.Taken
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @balBadge fw-semibold px-3 py-2">
                                            @row.Balance
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1"
                                                 style="height:8px;" title="@pct% used">
                                                <div class="progress-bar @barClass" role="progressbar"
                                                     style="width:@pct%"
                                                     aria-valuenow="@pct"
                                                     aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                            <span class="small fw-semibold text-muted"
                                                  style="min-width:40px;">@pct%</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (row.CarryForward)
                                        {
                                            <span class="badge bg-info-subtle text-info
                                                         border border-info-subtle">
                                                <i class="bi bi-arrow-right-circle me-1"></i>Yes
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary
                                                         border border-secondary-subtle">No</span>
                                        }
                                    </td>
                                    <td class="text-center d-print-none">
                                        @if (row.Applications.Any())
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary py-0"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target="#apps-@i"
                                                    aria-expanded="false"
                                                    title="View applications">
                                                <i class="bi bi-chevron-down"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                                @if (row.Applications.Any())
                                {
                                    <tr class="collapse d-print-none" id="apps-@i">
                                        <td colspan="8" class="p-0 bg-light">
                                            <div class="p-3">
                                                <p class="fw-semibold mb-2 text-primary small">
                                                    <i class="bi bi-list-ul me-1"></i>
                                                    Applications — @row.LeaveType
                                                    (@row.Applications.Count)
                                                </p>
                                                <table class="table table-sm table-bordered mb-0 bg-white">
                                                    <thead class="table-secondary">
                                                        <tr>
                                                            <th>Leave No.</th>
                                                            <th>From</th>
                                                            <th>To</th>
                                                            <th class="text-center">Days</th>
                                                            <th>Reason</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var app in row.Applications)
                                                        {
                                                            <tr>
                                                                <td class="text-primary fw-semibold small">
                                                                    @app.LeaveNumber
                                                                </td>
                                                                <td class="small">
                                                                    @app.StartDate.ToString("dd MMM yyyy")
                                                                </td>
                                                                <td class="small">
                                                                    @app.EndDate.ToString("dd MMM yyyy")
                                                                </td>
                                                                <td class="text-center fw-semibold">
                                                                    @app.TotalDays
                                                                </td>
                                                                <td class="small text-muted">
                                                                    @(string.IsNullOrWhiteSpace(app.Reason) ? "—" : app.Reason)
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light fw-semibold border-top border-2">
                            <tr>
                                <td colspan="2" class="text-end pe-3">Grand Total</td>
                                <td class="text-center">
                                    <span class="badge bg-success fw-bold fs-6 px-3 py-2">
                                        @Model.TotalAllowed
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-warning text-dark fw-bold fs-6 px-3 py-2">
                                        @Model.TotalTaken
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(Model.TotalBalance >= 0 ? "bg-primary" : "bg-danger") fw-bold fs-6 px-3 py-2">
                                        @Model.TotalBalance
                                    </span>
                                </td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════  UTILIZATION BARS  ═══════════════════════ -->
        <div class="card shadow-sm d-print-none">
            <div class="card-header bg-light py-3">
                <h6 class="mb-0 fw-semibold">
                    <i class="bi bi-bar-chart-fill me-2 text-primary"></i>Leave Utilization Overview
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var row in Model.Rows)
                    {
                        var pct = row.UtilizationPct;
                        var barClass = pct >= 100 ? "bg-danger"  :
                                       pct >= 75  ? "bg-warning" :
                                       pct >= 50  ? "bg-info"    : "bg-success";
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between small fw-semibold mb-1">
                                <span>@row.LeaveType</span>
                                <span class="text-muted">
                                    @row.Taken / @row.Allowed days &nbsp;(@pct%)
                                </span>
                            </div>
                            <div class="progress" style="height:14px;">
                                <div class="progress-bar @barClass" role="progressbar"
                                     style="width:@pct%; font-size:0.7rem; line-height:14px;"
                                     aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                    @if (pct >= 20)
                                    {
                                        @($"{pct}%")
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Restore selected employee after POST
            const savedEmp = '@(Model.SelectedEmployeeId?.ToString() ?? "")';
            if (savedEmp) {
                const sel = document.querySelector('select[name="SelectedEmployeeId"]');
                if (sel) sel.value = savedEmp;
            }

            // Flip chevron on collapse toggle
            document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(function (btn) {
                const target = document.querySelector(btn.getAttribute('data-bs-target'));
                if (!target) return;
                target.addEventListener('show.bs.collapse', function () {
                    btn.querySelector('i').classList.replace('bi-chevron-down', 'bi-chevron-up');
                });
                target.addEventListener('hide.bs.collapse', function () {
                    btn.querySelector('i').classList.replace('bi-chevron-up', 'bi-chevron-down');
                });
            });
        });
    </script>
}

<style>
    @@media print {
        .card        { box-shadow: none !important; border: 1px solid #dee2e6 !important; }
        .btn         { display: none !important; }
        .progress    { border: 1px solid #dee2e6; }
        nav, .sidebar, .page-header { display: none !important; }
    }
</style>
