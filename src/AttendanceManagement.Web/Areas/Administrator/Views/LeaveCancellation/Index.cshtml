@model AttendanceManagement.Web.ViewModels.LeaveCancellations.LeaveCancellationViewModel
@{
    ViewData["Title"] = "Leave Cancellation";
}

<div class="d-flex justify-content-between align-items-center mb-4">
@*     <div>
        <h2 class="h4 mb-1">Leave Cancellation</h2>
        <small class="text-muted">Cancel approved leave applications</small>
    </div> *@
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search Card -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Search" method="post" class="row g-3">
            <div class="col-md-8">
                <label asp-for="LeaveNumber" class="form-label fw-semibold">Leave Number</label>
                <input asp-for="LeaveNumber" class="form-control" placeholder="Enter leave number (e.g., LV-2024-001)" />
                <span asp-validation-for="LeaveNumber" class="text-danger"></span>
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search me-2"></i>Enter
                </button>
                <form asp-action="Clear" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg me-2"></i>Clear
                    </button>
                </form>
            </div>
        </form>
    </div>
</div>

<!-- Leave Details Card (shown when leave is found) -->
@if (Model.Id > 0)
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-3">
            <h5 class="mb-0"><i class="bi bi-file-text me-2 text-primary"></i>Leave Details</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label text-muted small">Leave Number</label>
                    <div class="fw-semibold">@Model.LeaveNumber</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small">Employee</label>
                    <div class="fw-semibold">@Model.EmployeeName (@Model.EmployeeNo)</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small">Leave Type</label>
                    <div class="fw-semibold">@Model.LeaveType</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small">Start Date</label>
                    <div class="fw-semibold">@Model.StartDate?.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small">End Date</label>
                    <div class="fw-semibold">@Model.EndDate?.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small">Total Days</label>
                    <div class="fw-semibold">@Model.TotalDays</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small">Status</label>
                    <div>
                        @if (Model.Status == "Approved")
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Approved</span>
                        }
                        else if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Rejected</span>
                        }
                        else if (Model.Status == "Cancelled")
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Cancelled</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark border">@Model.Status</span>
                        }
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small">Incharge Approval</label>
                    <div>
                        @if (Model.InchargeApprovalStatus == "Approved")
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Approved by @Model.InchargeName</span>
                        }
                        else if (Model.InchargeApprovalStatus == "Rejected")
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Rejected</span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Reason))
                {
                    <div class="col-md-12">
                        <label class="form-label text-muted small">Reason</label>
                        <div class="fw-semibold">@Model.Reason</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Cancellation Status Card -->
    @if (Model.CanCancel)
    {
        <div class="card shadow-sm mb-4 border-success">
            <div class="card-header bg-success-subtle py-3">
                <h5 class="mb-0"><i class="bi bi-check-circle me-2 text-success"></i>Leave Can Be Cancelled</h5>
            </div>
            <div class="card-body">
                <form asp-action="Cancel" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label asp-for="CancellationReason" class="form-label fw-semibold">Cancellation Reason</label>
                        <textarea asp-for="CancellationReason" class="form-control" rows="3" placeholder="Please provide a reason for cancellation..."></textarea>
                        <span asp-validation-for="CancellationReason" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-x-circle me-2"></i>Cancel Leave
                        </button>
                        <form asp-action="Clear" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Back
                            </button>
                        </form>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4 border-warning">
            <div class="card-header bg-warning-subtle py-3">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle me-2 text-warning"></i>Leave Cannot Be Cancelled</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-info-circle me-2"></i>@Model.CannotCancelReason
                </div>
                <div class="small text-muted">
                    <strong>Note:</strong> Only leaves that are approved by Incharge and are not of type Official, Short, or Withoutpay can be cancelled.
                </div>
                <div class="mt-3">
                    <form asp-action="Clear" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Back
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
}

<!-- Info Card -->
<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex align-items-start gap-3">
            <div class="info-icon bg-info bg-opacity-10 text-info">
                <i class="bi bi-info-circle"></i>
            </div>
            <div>
                <h6 class="fw-semibold mb-2">Cancellation Rules</h6>
                <ul class="mb-0 small text-muted">
                    <li>Only leaves approved by Incharge can be cancelled</li>
                    <li>Leave types <strong>Official</strong>, <strong>Short</strong>, and <strong>Withoutpay</strong> cannot be cancelled</li>
                    <li>Already cancelled leaves cannot be cancelled again</li>
                    <li>Enter the leave number to search and review before cancellation</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .info-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
