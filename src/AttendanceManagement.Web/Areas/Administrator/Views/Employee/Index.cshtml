@model List<AttendanceManagement.Web.ViewModels.Employees.EmployeeViewModel>
@{
    ViewData["Title"] = "Employees";
     ViewData["HidePageHeader"] = true;

      <div class="mb-4">
        <h2 class="h4 mb-1">Employee Directory</h2>
        <small class="text-muted">Manage all employees</small>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
     
    <a asp-action="AssignTeam" class="btn btn-outline-primary">Assign Team Members</a>
 
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Add Employee
    </a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-light">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name, employee no..." />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-2"></i>Search
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" data-no-pagination>
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Employee</th>
                        <th>Employee No</th>
                        <th>Company</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Type</th>
                        <th>Cell</th>
                        <th>Password</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var employee in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="employee-avatar me-3">
                                            <span class="avatar-initials">@employee.Name.Substring(0, 1).ToUpper()</span>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@employee.Name</div>
                                            <small class="text-muted">ID: @employee.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@employee.EmployeeNo</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-building text-muted small"></i>
                                        <span>@employee.CompanyName</span>
                                    </div>
                                </td>
                                <td>@employee.DepartmentName</td>
                                <td>@employee.DesignationName</td>
                                <td>@employee.EmployeeType</td>
                                <td>@employee.Cell</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(employee.Password))
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-shield-lock me-1"></i>Set
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">
                                            <i class="bi bi-shield-lock-open me-1"></i>Not Set
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (employee.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle me-1"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            <i class="bi bi-circle me-1"></i>Inactive
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@employee.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this employee?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    <p class="mb-0">No employees found</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (ViewBag.TotalPages > 1)
    {
        <div class="table-pagination">
            <span>Showing @(((int)ViewBag.Page - 1) * (int)ViewBag.PageSize + 1)–@Math.Min((int)ViewBag.Page * (int)ViewBag.PageSize, (int)ViewBag.Total) of @ViewBag.Total employees</span>
            <nav aria-label="Employee pages"><ul class="pagination pagination-sm mb-0">
                <li class="page-item @((int)ViewBag.Page == 1 ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.Page - 1)" asp-route-search="@ViewBag.Search">Previous</a></li>
                @for (var pageNumber = 1; pageNumber <= (int)ViewBag.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == (int)ViewBag.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@pageNumber" asp-route-search="@ViewBag.Search" aria-current="@(pageNumber == (int)ViewBag.Page ? "page" : null)">@pageNumber</a></li>
                }
                <li class="page-item @((int)ViewBag.Page == (int)ViewBag.TotalPages ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@((int)ViewBag.Page + 1)" asp-route-search="@ViewBag.Search">Next</a></li>
            </ul></nav>
        </div>
    }
</div>

<style>
    .employee-avatar {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .avatar-initials {
        color: white;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .badge {
        padding: 0.5rem 0.75rem;
        font-weight: 500;
    }
</style>
