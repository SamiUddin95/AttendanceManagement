@model List<AttendanceManagement.Web.Areas.Administrator.Controllers.RecordedAttendanceRow>
@{ ViewData["Title"] = "Recorded Attendance Report"; }
<form method="get" class="d-flex gap-3 mb-3">
    <label>From <input type="date" name="from" value="@ViewBag.From" class="form-control" required /></label>
    <label>To <input type="date" name="to" value="@ViewBag.To" class="form-control" required /></label>
    <button class="btn btn-primary" type="submit">Show attendance</button>
</form>
<p>Recorded punches only. Missing punches need review; days without any punches are not classified as absences. Extra hours use the existing eight-hour baseline and are not approved payable overtime.</p>
<div class="table-responsive"><table class="table table-striped">
    <thead><tr><th>Employee</th><th>Name</th><th>Date</th><th>In</th><th>Out</th><th>Extra hours</th><th>Status</th></tr></thead>
    <tbody>@foreach(var row in Model) { <tr><td>@row.EmployeeNo</td><td>@row.EmployeeName</td><td>@row.Timing.Date.ToString("dd MMM yyyy")</td><td>@row.Timing.TimeIn</td><td>@row.Timing.TimeOut</td><td>@row.Timing.ExtraHours</td><td>@row.Timing.Status</td></tr> }</tbody>
</table></div>
@if(Model.Count == 0) { <p>No recorded punches in this period.</p> }
