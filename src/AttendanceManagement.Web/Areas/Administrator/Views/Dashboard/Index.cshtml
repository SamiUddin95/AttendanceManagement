@model IEnumerable<AttendanceManagement.Application.Contracts.Companies.CompanyDto>
@{
    ViewData["Title"] = "Administrator Hub";
}

<section class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <p class="text-muted mb-1">Total Companies</p>
            <h2 class="display-6">@ViewData["TotalCompanies"]</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <p class="text-muted mb-1">Active Companies</p>
            <h2 class="display-6 text-success">@ViewData["ActiveCompanies"]</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <p class="text-muted mb-1">Inactive Companies</p>
            <h2 class="display-6 text-danger">@ViewData["InactiveCompanies"]</h2>
        </div>
    </div>
</section>

<div class="card card-panel">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">Recent Companies</h5>
            <small class="text-muted">Last 6 updates</small>
        </div>
        <a asp-area="Administrator" asp-controller="Company" asp-action="Index" class="btn btn-outline-primary btn-sm">Manage</a>
    </div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Domain</th>
                    <th>Country</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var company in Model)
            {
                <tr>
                    <td>@company.Name</td>
                    <td>@company.Domain</td>
                    <td>@company.CountryName</td>
                    <td>
                        <span class="badge @(company.IsActive ? "bg-success" : "bg-secondary")">
                            @(company.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
