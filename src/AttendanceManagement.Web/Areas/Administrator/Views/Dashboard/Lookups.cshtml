@model AttendanceManagement.Web.ViewModels.Lookups.LookupBoardViewModel
@{
    ViewData["Title"] ??= "Lookup Catalog";
}

<div class="lookup-board">
    @foreach (var section in Model.Sections)
    {
        var isFocus = string.Equals(section.Key, Model.ActiveSection, StringComparison.OrdinalIgnoreCase);
        <article class="lookup-card @(isFocus ? "is-focused" : string.Empty)" id="card-@(section.Key)">
            <header class="lookup-card__header">
                <div>
                    <p class="lookup-card__eyebrow text-uppercase">@(section.Title) settings</p>
                    <h2>@(section.Title)</h2>
                    <p class="text-muted mb-0">@(section.Description)</p>
                </div>
                <button type="button" class="btn lookup-add" data-section="@(section.Key)" data-action="add">
                    <i class="bi bi-plus-lg me-2"></i>
                    Add New
                </button>
            </header>
            <div class="lookup-card__body">
                <div class="table-responsive">
                    <table class="table lookup-table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Name</th>
                                @if (section.Key == "designations")
                                {
                                    <th scope="col">Incharge</th>
                                }
                                <th scope="col">Status</th>
                                <th scope="col" class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in section.Items)
                            {
                                <tr data-id="@item.Id" data-section="@(section.Key)">
                                    <td>@item.Id</td>
                                    <td>@item.Name</td>
                                    @if (section.Key == "designations")
                                    {
                                        <td>
                                            <label class="lookup-toggle">
                                                <input type="checkbox" class="isIncharge-toggle" @(item.IsIncharge == true ? "checked" : null) />
                                                <span></span>
                                            </label>
                                        </td>
                                    }
                                    <td>
                                        <label class="lookup-toggle">
                                            <input type="checkbox" class="status-toggle" @(item.IsActive ? "checked" : null) />
                                            <span></span>
                                        </label>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex gap-1 justify-content-end">
                                            <button type="button" class="lookup-action lookup-action--edit btn-edit" data-id="@item.Id" data-name="@item.Name" data-isincharge="@((item.IsIncharge == true).ToString().ToLower())">Edit</button>
                                            <button type="button" class="lookup-action lookup-action--delete btn-delete" data-id="@item.Id">Del</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (section.TotalPages > 1)
                {
                    <nav class="mt-3" aria-label="Page navigation">
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            @if (section.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="#" data-section="@(section.Key)" data-page="@(section.CurrentPage - 1)">Previous</a>
                                </li>
                            }
                            @for (int i = 1; i <= section.TotalPages; i++)
                            {
                                <li class="page-item @(i == section.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="#" data-section="@(section.Key)" data-page="@i">@i</a>
                                </li>
                            }
                            @if (section.CurrentPage < section.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="#" data-section="@(section.Key)" data-page="@(section.CurrentPage + 1)">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </article>
    }
</div>

<div class="modal fade" id="lookupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="lookupModalTitle">Add New</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="lookupForm">
                    <input type="hidden" id="lookupId" />
                    <input type="hidden" id="lookupSection" />
                    <input type="hidden" id="lookupAction" />
                    <div class="mb-3">
                        <label for="lookupName" class="form-label">Name</label>
                        <input type="text" class="form-control" id="lookupName" required maxlength="150" />
                    </div>
                    <div class="mb-3" id="isInchargeContainer" style="display: none;">
                        <label for="lookupIsIncharge" class="form-label">Is Incharge</label>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="lookupIsIncharge" />
                            <label class="form-check-label" for="lookupIsIncharge">Mark as Incharge</label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="lookupSaveBtn">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this item? This action cannot be undone.</p>
                <input type="hidden" id="deleteId" />
                <input type="hidden" id="deleteSection" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="deleteConfirmBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const activeSection = '@Model.ActiveSection';
            const focusedCard = document.getElementById('card-' + activeSection);
            if (focusedCard) {
                focusedCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            function getAntiForgeryToken() {
                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : '';
            }

            const modal = new bootstrap.Modal(document.getElementById('lookupModal'));
            const modalTitle = document.getElementById('lookupModalTitle');
            const lookupId = document.getElementById('lookupId');
            const lookupSection = document.getElementById('lookupSection');
            const lookupAction = document.getElementById('lookupAction');
            const lookupName = document.getElementById('lookupName');
            const lookupIsIncharge = document.getElementById('lookupIsIncharge');
            const isInchargeContainer = document.getElementById('isInchargeContainer');
            const lookupSaveBtn = document.getElementById('lookupSaveBtn');

            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            const deleteId = document.getElementById('deleteId');
            const deleteSection = document.getElementById('deleteSection');
            const deleteConfirmBtn = document.getElementById('deleteConfirmBtn');
            let deleteRow = null;

            document.querySelectorAll('.lookup-add').forEach(btn => {
                btn.addEventListener('click', function() {
                    const section = this.dataset.section;
                    modalTitle.textContent = 'Add New ' + section.charAt(0).toUpperCase() + section.slice(1).slice(0, -1);
                    lookupId.value = '';
                    lookupSection.value = section;
                    lookupAction.value = 'add';
                    lookupName.value = '';
                    lookupIsIncharge.checked = false;
                    isInchargeContainer.style.display = section === 'designations' ? 'block' : 'none';
                    modal.show();
                });
            });

            document.querySelectorAll('.btn-edit').forEach(btn => {
                btn.addEventListener('click', function() {
                    const row = this.closest('tr');
                    const id = this.dataset.id;
                    const name = this.dataset.name;
                    const isIncharge = this.dataset.isincharge;
                    const section = row.dataset.section;
                    modalTitle.textContent = 'Edit ' + section.charAt(0).toUpperCase() + section.slice(1).slice(0, -1);
                    lookupId.value = id;
                    lookupSection.value = section;
                    lookupAction.value = 'edit';
                    lookupName.value = name;
                    lookupIsIncharge.checked = isIncharge === 'true';
                    isInchargeContainer.style.display = section === 'designations' ? 'block' : 'none';
                    modal.show();
                });
            });

            document.querySelectorAll('.btn-delete').forEach(btn => {
                btn.addEventListener('click', function() {
                    const row = this.closest('tr');
                    const id = this.dataset.id;
                    const section = row.dataset.section;
                    deleteId.value = id;
                    deleteSection.value = section;
                    deleteRow = row;
                    deleteModal.show();
                });
            });

            deleteConfirmBtn.addEventListener('click', function() {
                const id = deleteId.value;
                const section = deleteSection.value;
                deleteItem(section, id, deleteRow);
                deleteModal.hide();
            });

            document.querySelectorAll('.pagination .page-link').forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    const section = this.dataset.section;
                    const page = this.dataset.page;
                    changePage(section, page);
                });
            });

            document.querySelectorAll('.status-toggle').forEach(toggle => {
                toggle.addEventListener('change', function() {
                    const row = this.closest('tr');
                    const id = row.dataset.id;
                    const section = row.dataset.section;
                    toggleStatus(section, id, this);
                });
            });

            document.querySelectorAll('.isIncharge-toggle').forEach(toggle => {
                toggle.addEventListener('change', function() {
                    const row = this.closest('tr');
                    const id = row.dataset.id;
                    toggleIsIncharge(id, this);
                });
            });

            lookupSaveBtn.addEventListener('click', function() {
                const name = lookupName.value.trim();
                if (!name) {
                    alert('Name is required');
                    return;
                }

                const section = lookupSection.value;
                const action = lookupAction.value;
                const id = lookupId.value;
                const isIncharge = lookupIsIncharge.checked;

                if (action === 'add') {
                    addItem(section, name, isIncharge);
                } else {
                    updateItem(section, id, name, isIncharge);
                }
            });

            function addItem(section, name, isIncharge) {
                const endpoint = getEndpoint(section, 'Add');
                const token = getAntiForgeryToken();
                const formData = new FormData();
                formData.append('name', name);
                formData.append('__RequestVerificationToken', token);
                if (section === 'designations') {
                    formData.append('isIncharge', isIncharge);
                }

                fetch(endpoint, {
                    method: 'POST',
                    body: formData
                })
                .then(r => {
                    if (!r.ok) {
                        throw new Error('HTTP error: ' + r.status);
                    }
                    return r.text();
                })
                .then(text => {
                    if (!text) {
                        throw new Error('Empty response');
                    }
                    return JSON.parse(text);
                })
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Failed to add item');
                    }
                })
                .catch(err => alert('Error: ' + err));
            }

            function updateItem(section, id, name, isIncharge) {
                const endpoint = getEndpoint(section, 'Update') + '?id=' + id;
                const token = getAntiForgeryToken();
                const formData = new FormData();
                formData.append('name', name);
                formData.append('__RequestVerificationToken', token);
                if (section === 'designations') {
                    formData.append('isIncharge', isIncharge);
                }

                fetch(endpoint, {
                    method: 'POST',
                    body: formData
                })
                .then(r => {
                    if (!r.ok) {
                        throw new Error('HTTP error: ' + r.status);
                    }
                    return r.text();
                })
                .then(text => {
                    if (!text) {
                        throw new Error('Empty response');
                    }
                    return JSON.parse(text);
                })
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Failed to update item');
                    }
                })
                .catch(err => alert('Error: ' + err));
            }

            function deleteItem(section, id, row) {
                const endpoint = getEndpoint(section, 'Delete') + '?id=' + id;
                const token = getAntiForgeryToken();
                const formData = new FormData();
                formData.append('__RequestVerificationToken', token);

                fetch(endpoint, {
                    method: 'POST',
                    body: formData
                })
                .then(r => {
                    if (!r.ok) {
                        throw new Error('HTTP error: ' + r.status);
                    }
                    return r.text();
                })
                .then(text => {
                    if (!text) {
                        throw new Error('Empty response');
                    }
                    return JSON.parse(text);
                })
                .then(data => {
                    if (data.success) {
                        row.remove();
                    } else {
                        alert('Failed to delete item');
                    }
                })
                .catch(err => alert('Error: ' + err));
            }

            function toggleStatus(section, id, toggle) {
                const endpoint = getEndpoint(section, 'ToggleStatus') + '?id=' + id;
                const token = getAntiForgeryToken();
                const formData = new FormData();
                formData.append('__RequestVerificationToken', token);

                fetch(endpoint, {
                    method: 'POST',
                    body: formData
                })
                .then(r => {
                    if (!r.ok) {
                        throw new Error('HTTP error: ' + r.status);
                    }
                    return r.text();
                })
                .then(text => {
                    if (!text) {
                        throw new Error('Empty response');
                    }
                    return JSON.parse(text);
                })
                .then(data => {
                    if (!data.success) {
                        toggle.checked = !toggle.checked;
                        alert('Failed to update status');
                    }
                })
                .catch(err => {
                    toggle.checked = !toggle.checked;
                    alert('Error: ' + err);
                });
            }

            function toggleIsIncharge(id, toggle) {
                const endpoint = '/Administrator/Dashboard/ToggleDesignationIsIncharge?id=' + id;
                const token = getAntiForgeryToken();
                const formData = new FormData();
                formData.append('__RequestVerificationToken', token);

                fetch(endpoint, {
                    method: 'POST',
                    body: formData
                })
                .then(r => {
                    if (!r.ok) {
                        throw new Error('HTTP error: ' + r.status);
                    }
                    return r.text();
                })
                .then(text => {
                    if (!text) {
                        throw new Error('Empty response');
                    }
                    return JSON.parse(text);
                })
                .then(data => {
                    if (!data.success) {
                        toggle.checked = !toggle.checked;
                        alert('Failed to update incharge status');
                    }
                })
                .catch(err => {
                    toggle.checked = !toggle.checked;
                    alert('Error: ' + err);
                });
            }

            function getEndpoint(section, action) {
                let sectionName = section.charAt(0).toUpperCase() + section.slice(1);
                if (sectionName.endsWith('ies')) {
                    sectionName = sectionName.slice(0, -3) + 'y';
                } else if (sectionName.endsWith('s')) {
                    sectionName = sectionName.slice(0, -1);
                }

                if (action === 'ToggleStatus') {
                    return '/Administrator/Dashboard/Toggle' + sectionName + 'Status';
                }
                return '/Administrator/Dashboard/' + action + sectionName;
            }

            function changePage(section, page) {
                const url = new URL(window.location);
                url.searchParams.set('section', section);
                
                // Set the page parameter for the specific section
                const pageParam = section + 'Page';
                url.searchParams.set(pageParam, page);
                
                window.location.href = url.toString();
            }
        });
    </script>
}
