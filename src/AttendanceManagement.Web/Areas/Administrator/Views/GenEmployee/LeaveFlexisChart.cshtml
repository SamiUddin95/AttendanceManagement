@model AttendanceManagement.Web.ViewModels.LeaveFlexisChart.LeaveFlexisChartViewModel
@{
    ViewData["Title"] = "Leave/Flexis Chart";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">Leave / Flexis Chart</h2>
        <small class="text-muted">Visual overview of your leave balances</small>
    </div>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-primary h-100">
            <div class="card-body text-center">
                <div class="fs-3 fw-bold text-primary">@Model.TotalEntitledDays</div>
                <div class="text-muted small">Total Entitled Days</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-warning h-100">
            <div class="card-body text-center">
                <div class="fs-3 fw-bold text-warning">@Model.TotalUsedDays</div>
                <div class="text-muted small">Total Used Days</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-success h-100">
            <div class="card-body text-center">
                <div class="fs-3 fw-bold text-success">@Model.TotalRemainingDays</div>
                <div class="text-muted small">Total Remaining Days</div>
            </div>
        </div>
    </div>
</div>

<!-- Leave Balance Chart -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-light py-3">
        <h5 class="mb-0"><i class="bi bi-bar-chart me-2 text-primary"></i>Leave Balance Overview</h5>
    </div>
    <div class="card-body">
        @if (Model.LeaveBalances.Any())
        {
            <div class="row g-3">
                @foreach (var balance in Model.LeaveBalances)
                {
                    var usagePercent = balance.UsagePercentage;
                    var progressClass = usagePercent >= 90 ? "bg-danger" : (usagePercent >= 70 ? "bg-warning" : "bg-success");
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border-0 bg-light">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-info-subtle text-info">@balance.LeaveType</span>
                                    @if (balance.CarryForward)
                                    {
                                        <span class="badge bg-success-subtle text-success small">
                                            <i class="bi bi-arrow-repeat me-1"></i>Carry Forward
                                        </span>
                                    }
                                </div>
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span>Used: @balance.UsedDays / @balance.EntitledDays days</span>
                                        <span class="fw-semibold">@usagePercent.ToString("F1")%</span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar @progressClass" role="progressbar" 
                                             style="width: @Math.Min(usagePercent, 100)%" 
                                             aria-valuenow="@usagePercent" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between small">
                                    <span class="text-danger"><i class="bi bi-x-circle me-1"></i>@balance.UsedDays Used</span>
                                    <span class="text-success"><i class="bi bi-check-circle me-1"></i>@balance.RemainingDays Left</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="text-muted">
                    <i class="bi bi-bar-chart fs-1 d-block mb-2"></i>
                    <p class="mb-0">No leave balance data available</p>
                    <small class="text-muted">Leave entitlements will appear here once policy is assigned</small>
                </div>
            </div>
        }
    </div>
</div>

<!-- Detailed Leave Balance Table -->
@if (Model.LeaveBalances.Any())
{
    <div class="card shadow-sm">
        <div class="card-header bg-light py-3">
            <h5 class="mb-0"><i class="bi bi-table me-2 text-primary"></i>Detailed Leave Balances</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Leave Type</th>
                            <th class="text-center">Entitled</th>
                            <th class="text-center">Used</th>
                            <th class="text-center">Remaining</th>
                            <th class="text-center">Usage %</th>
                            <th class="text-center">Carry Forward</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var balance in Model.LeaveBalances)
                        {
                            var usagePercent = balance.UsagePercentage;
                            var progressClass = usagePercent >= 90 ? "text-danger" : (usagePercent >= 70 ? "text-warning" : "text-success");
                            <tr>
                                <td>
                                    <span class="badge bg-info-subtle text-info">@balance.LeaveType</span>
                                </td>
                                <td class="text-center fw-semibold">@balance.EntitledDays</td>
                                <td class="text-center text-danger">@balance.UsedDays</td>
                                <td class="text-center text-success fw-semibold">@balance.RemainingDays</td>
                                <td class="text-center">
                                    <span class="fw-semibold @progressClass">@usagePercent.ToString("F1")%</span>
                                </td>
                                <td class="text-center">
                                    @if (balance.CarryForward)
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-check me-1"></i>Yes
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">
                                            <i class="bi bi-x me-1"></i>No
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
