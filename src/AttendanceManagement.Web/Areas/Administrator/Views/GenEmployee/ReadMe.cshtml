@{
    ViewData["Title"] = "Read Me";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">Read Me</h2>
        <small class="text-muted">Employee Guidelines & Information</small>
    </div>
</div>

<div class="row g-4">
    <!-- Welcome Section -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Welcome to Attendance Management System</h5>
            </div>
            <div class="card-body">
                <p class="lead">Welcome to the Employee Portal of the Attendance Management System (AMS). This system is designed to help you manage your attendance, leave requests, and view your work-related information efficiently.</p>
                <hr>
                <h6>Quick Links</h6>
                <ul class="list-unstyled">
                    <li><i class="bi bi-chevron-right text-primary me-2"></i><strong>Leave History</strong> - View your past leave applications and their status</li>
                    <li><i class="bi bi-chevron-right text-primary me-2"></i><strong>In/Out Timings</strong> - Check your daily attendance records</li>
                    <li><i class="bi bi-chevron-right text-primary me-2"></i><strong>Apply for Leave</strong> - Submit new leave requests</li>
                    <li><i class="bi bi-chevron-right text-primary me-2"></i><strong>View Calendar</strong> - View company holidays and your schedule</li>
                    <li><i class="bi bi-chevron-right text-primary me-2"></i><strong>Change Password</strong> - Update your login credentials</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Attendance Rules -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-clock me-2 text-primary"></i>Attendance Rules</h5>
            </div>
            <div class="card-body">
                <ul class="mb-0">
                    <li>Punch in/out using the designated biometric device or mobile app</li>
                    <li>Core working hours: 9:00 AM - 6:00 PM (may vary by shift)</li>
                    <li>Late arrival after 9:15 AM will be marked as late</li>
                    <li>Early departure before 5:45 PM requires prior approval</li>
                    <li>Minimum 8 hours required for full day attendance</li>
                    <li>Less than 4 hours will be marked as half day</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Leave Policy Summary -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-calendar-check me-2 text-primary"></i>Leave Policy Summary</h5>
            </div>
            <div class="card-body">
                <ul class="mb-0">
                    <li><strong>Annual Leave:</strong> 21 days per year (accrued monthly)</li>
                    <li><strong>Sick Leave:</strong> 10 days per year</li>
                    <li><strong>Casual Leave:</strong> 5 days per year</li>
                    <li>Leave applications must be submitted at least 3 days in advance</li>
                    <li>Emergency leave requires notification within 24 hours</li>
                    <li>Unused annual leave can be carried forward (max 10 days)</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Overtime Policy -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Overtime Policy</h5>
            </div>
            <div class="card-body">
                <ul class="mb-0">
                    <li>Overtime requires prior approval from supervisor</li>
                    <li>Maximum 2 hours overtime per day</li>
                    <li>Maximum 12 hours overtime per week</li>
                    <li>Overtime paid at 1.5x hourly rate</li>
                    <li>Weekend/holiday overtime paid at 2x hourly rate</li>
                    <li>Submit overtime request within 48 hours</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Contact & Support -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-headset me-2 text-primary"></i>Support & Contacts</h5>
            </div>
            <div class="card-body">
                <ul class="mb-0">
                    <li><strong>HR Department:</strong> hr@company.com | Ext: 100</li>
                    <li><strong>IT Support:</strong> it@company.com | Ext: 200</li>
                    <li><strong>Payroll:</strong> payroll@company.com | Ext: 300</li>
                    <li><strong>Admin Portal:</strong> Contact your department head</li>
                    <li>For technical issues, raise a ticket via the helpdesk</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Important Notes -->
    <div class="col-12">
        <div class="card shadow-sm border-warning">
            <div class="card-header bg-warning bg-opacity-10">
                <h5 class="mb-0 text-warning"><i class="bi bi-exclamation-triangle me-2"></i>Important Notes</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6>Do's</h6>
                        <ul class="text-success">
                            <li>Keep your contact information updated</li>
                            <li>Check your attendance regularly</li>
                            <li>Apply for leave in advance</li>
                            <li>Report discrepancies immediately</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6>Don'ts</h6>
                        <ul class="text-danger">
                            <li>Share your login credentials</li>
                            <li>Punch for colleagues (proxy attendance)</li>
                            <li>Modify attendance records</li>
                            <li>Ignore system notifications</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
