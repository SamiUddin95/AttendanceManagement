@model AttendanceManagement.Web.ViewModels.Groups.GroupListViewModel
@{
    ViewData["Title"] = "Groups";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">Group Management</h2>
        <small class="text-muted">Manage employee groups and filters</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i>Add Group
    </a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-light">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by group name, code..." />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-2"></i>Search
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Group</th>
                        <th>Company</th>
                        <th>Code</th>
                        <th>Employment Type</th>
                        <th>Gender</th>
                        <th>Filters</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Groups != null && Model.Groups.Any())
                    {
                        @foreach (var group in Model.Groups)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="group-avatar me-3">
                                            <i class="bi bi-people"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@group.Name</div>
                                            <small class="text-muted">ID: @group.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-building text-muted small"></i>
                                        <span>@group.CompanyName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@group.Code</span>
                                </td>
                                <td>@group.EmploymentType</td>
                                <td>@group.Gender</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (group.FilterByDepartment)
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle">Dept</span>
                                        }
                                        @if (group.FilterByDesignation)
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Desig</span>
                                        }
                                        @if (group.FilterByLocation)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Loc</span>
                                        }
                                        @if (group.FilterByIncharge)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Incharge</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (group.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle me-1"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                            <i class="bi bi-circle me-1"></i>Inactive
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@group.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@group.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this group?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    <p class="mb-0">No groups found</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .group-avatar {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.1rem;
    }

    .badge {
        padding: 0.5rem 0.75rem;
        font-weight: 500;
    }
</style>
