@model AttendanceManagement.Web.ViewModels.SuperUser.AssignRoleListViewModel
@{
    ViewData["Title"] = "Assign Roles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">Assign Roles</h2>
        <small class="text-muted">Assign roles to groups or individual employees</small>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>New Assignment
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header bg-light py-3">
        <h5 class="mb-0"><i class="bi bi-person-badge me-2 text-primary"></i>Role Assignments</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Assignments.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Company</th>
                            <th>Type</th>
                            <th>Role</th>
                            <th>Group / Department</th>
                            <th>Employee</th>
                            <th>Status</th>
                            <th style="width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assignment in Model.Assignments)
                        {
                            <tr>
                                <td class="fw-semibold">@assignment.CompanyName</td>
                                <td>
                                    <span class="badge @(assignment.AssignmentType == "Group" ? "bg-info" : "bg-success")">
                                        <i class="bi @(assignment.AssignmentType == "Group" ? "bi-people" : "bi-person") me-1"></i>
                                        @assignment.AssignmentType
                                    </span>
                                </td>
                                <td>@assignment.RoleName</td>
                                <td>
                                    @if (assignment.AssignmentType == "Group")
                                    {
                                        <span class="badge bg-info-subtle text-info">@assignment.GroupName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success">@assignment.DepartmentName</span>
                                    }
                                </td>
                                <td>
                                    @if (assignment.AssignmentType == "Individual")
                                    {
                                        <div>@assignment.EmployeeName</div>
                                        <small class="text-muted">@assignment.EmployeeNo</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (assignment.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@assignment.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" 
                                                onclick="confirmDelete(@assignment.Id, '@assignment.RoleName')" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="text-muted">
                    <i class="bi bi-person-badge fs-1 d-block mb-2"></i>
                    <p class="mb-0">No role assignments found</p>
                    <small class="text-muted">Create your first role assignment</small>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function confirmDelete(id, name) {
        if (confirm(`Are you sure you want to delete role assignment for "${name}"?`)) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/SuperUser/AssignRole/Delete/${id}`;
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token.value;
                form.appendChild(tokenInput);
            }
            
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>
