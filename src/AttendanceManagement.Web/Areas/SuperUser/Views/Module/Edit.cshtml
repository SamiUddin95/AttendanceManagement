@model AttendanceManagement.Domain.Entities.Module
@{
    ViewData["Title"] = Model.Id > 0 ? "Edit Module" : "Create Module";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">@(Model.Id > 0 ? "Edit" : "Create") Module</h2>
        <small class="text-muted">@(Model.Id > 0 ? "Update module details" : "Define a new module for role permissions")</small>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="@(Model.Id > 0 ? "Edit" : "Create")" method="post">
    @Html.AntiForgeryToken()
    @if (Model.Id > 0)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light py-3">
            <h5 class="mb-0"><i class="bi bi-grid me-2 text-primary"></i>Module Information</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label fw-semibold">Module Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g., Employee, Leave, Shift" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                    <small class="text-muted">Unique identifier (no spaces)</small>
                </div>
                <div class="col-md-6">
                    <label asp-for="DisplayName" class="form-label fw-semibold">Display Name</label>
                    <input asp-for="DisplayName" class="form-control" placeholder="e.g., Employee Management" />
                    <span asp-validation-for="DisplayName" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the module purpose..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SortOrder" class="form-label fw-semibold">Sort Order</label>
                    <input asp-for="SortOrder" class="form-control" type="number" min="0" />
                    <span asp-validation-for="SortOrder" class="text-danger"></span>
                    <small class="text-muted">Lower values appear first</small>
                </div>
                <div class="col-md-4">
                    <div class="form-check form-switch mt-4">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label class="form-check-label fw-semibold" asp-for="IsActive">Active</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save me-2"></i>@(Model.Id > 0 ? "Update" : "Create") Module
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg me-2"></i>Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
