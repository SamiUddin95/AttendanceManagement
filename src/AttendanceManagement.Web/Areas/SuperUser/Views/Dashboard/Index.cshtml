@{
    ViewData["Title"] = "Super User Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">Super User Dashboard</h2>
        <small class="text-muted">Overview of role-based access control</small>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm border-primary h-100">
            <div class="card-body text-center">
                <div class="fs-2 fw-bold text-primary">@ViewData["TotalCompanies"]</div>
                <div class="text-muted small">Companies</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm border-info h-100">
            <div class="card-body text-center">
                <div class="fs-2 fw-bold text-info">@ViewData["TotalRoles"]</div>
                <div class="text-muted small">Active Roles</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm border-success h-100">
            <div class="card-body text-center">
                <div class="fs-2 fw-bold text-success">@ViewData["TotalModules"]</div>
                <div class="text-muted small">Active Modules</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm border-warning h-100">
            <div class="card-body text-center">
                <div class="fs-2 fw-bold text-warning">@ViewData["TotalAssignments"]</div>
                <div class="text-muted small">Active Assignments</div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <a asp-area="SuperUser" asp-controller="Role" asp-action="Create" class="card shadow-sm h-100 text-decoration-none">
            <div class="card-body text-center p-4">
                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-shield-lock fs-2 text-primary"></i>
                </div>
                <h5 class="mb-1">Create Role</h5>
                <p class="text-muted small mb-0">Define new roles with permissions</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a asp-area="SuperUser" asp-controller="AssignRole" asp-action="Create" class="card shadow-sm h-100 text-decoration-none">
            <div class="card-body text-center p-4">
                <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-person-badge fs-2 text-info"></i>
                </div>
                <h5 class="mb-1">Assign Role</h5>
                <p class="text-muted small mb-0">Assign roles to groups or individuals</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a asp-area="SuperUser" asp-controller="Role" asp-action="Index" class="card shadow-sm h-100 text-decoration-none">
            <div class="card-body text-center p-4">
                <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-list-ul fs-2 text-success"></i>
                </div>
                <h5 class="mb-1">View Roles</h5>
                <p class="text-muted small mb-0">Manage existing roles</p>
            </div>
        </a>
    </div>
    <div class="col-md-6 col-lg-3">
        <a asp-area="SuperUser" asp-controller="AssignRole" asp-action="Index" class="card shadow-sm h-100 text-decoration-none">
            <div class="card-body text-center p-4">
                <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                    <i class="bi bi-people fs-2 text-warning"></i>
                </div>
                <h5 class="mb-1">View Assignments</h5>
                <p class="text-muted small mb-0">Manage role assignments</p>
            </div>
        </a>
    </div>
</div>

<!-- Recent Activity -->
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light py-3">
                <h5 class="mb-0"><i class="bi bi-shield-lock me-2 text-primary"></i>Recent Roles</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Role</th>
                                <th>Display Name</th>
                                <th>Modules</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="bi bi-info-circle fs-1 d-block mb-2"></i>
                                    <p class="mb-0">No roles created yet</p>
                                    <small>Create your first role to get started</small>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light py-3">
                <h5 class="mb-0"><i class="bi bi-person-badge me-2 text-info"></i>Recent Assignments</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Company</th>
                                <th>Type</th>
                                <th>Role</th>
                                <th>Target</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="bi bi-info-circle fs-1 d-block mb-2"></i>
                                    <p class="mb-0">No assignments created yet</p>
                                    <small>Assign roles to groups or individuals</small>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
