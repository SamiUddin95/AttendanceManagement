@model AttendanceManagement.Web.ViewModels.SuperUser.RoleListViewModel
@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">Role Management</h2>
        <small class="text-muted">Manage roles and module permissions</small>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>Create Role
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header bg-light py-3">
        <h5 class="mb-0"><i class="bi bi-shield-lock me-2 text-primary"></i>Roles</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Roles.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Role Name</th>
                            <th>Display Name</th>
                            <th>Description</th>
                            <th>Modules</th>
                            <th>Status</th>
                            <th style="width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in Model.Roles)
                        {
                            <tr>
                                <td class="fw-semibold">@role.Name</td>
                                <td>@role.DisplayName</td>
                                <td class="text-muted small">@role.Description</td>
                                <td>
                                    @if (role.RoleModules.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var rm in role.RoleModules)
                                            {
                                                <span class="badge bg-info-subtle text-info small">
                                                    @rm.ModuleDisplayName
                                                    <span class="ms-1">
                                                        @(rm.CanView ? "<i class='bi bi-eye'></i>" : "")
                                                        @(rm.CanCreate ? "<i class='bi bi-plus'></i>" : "")
                                                        @(rm.CanEdit ? "<i class='bi bi-pencil'></i>" : "")
                                                        @(rm.CanDelete ? "<i class='bi bi-trash'></i>" : "")
                                                    </span>
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No modules assigned</span>
                                    }
                                </td>
                                <td>
                                    @if (role.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" 
                                                onclick="confirmDelete(@role.Id, '@role.Name')" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="text-muted">
                    <i class="bi bi-shield-lock fs-1 d-block mb-2"></i>
                    <p class="mb-0">No roles found</p>
                    <small class="text-muted">Create your first role to get started</small>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function confirmDelete(id, name) {
        if (confirm(`Are you sure you want to delete role "${name}"?`)) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/SuperUser/Role/Delete/${id}`;
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token.value;
                form.appendChild(tokenInput);
            }
            
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>
